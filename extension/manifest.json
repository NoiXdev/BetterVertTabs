{
  "manifest_version": 3,
  "name": "BetterVertTabs",
  "version": "0.0.0",
  "description": "Vertical tabs with pinned tiles, tab groups and drag & drop – an Arc/Zen-style sidebar for Firefox.",
  "browser_specific_settings": {
    "gecko": {
      "id": "betterverttabs@noixdev",
      "strict_min_version": "139.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "sessions"
  ],
  "sidebar_action": {
    "default_title": "BetterVertTabs",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": "icons/icon.svg",
    "open_at_install": true
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Toggle the sidebar"
    }
  },
  "homepage_url": "https://github.com/NoiXdev/BetterVertTabs"
}
